{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "target": "ES2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "lib": ["ES2022"],
        // 渐进迁移：.js 文件参与解析但不做类型检查，.ts/.vue(lang=ts) 受 strict 约束
        "allowJs": true,
        "checkJs": false,
        "strict": true,
        // 2026-11-14 迁移期曾暂关 noImplicitAny；随后已补齐全部隐式参数/
        // 变量的显式 any 标注（TS7006/7031/7053/7034 等族清零），现已开启。
        "noImplicitAny": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "useDefineForClassFields": true
    }
}
