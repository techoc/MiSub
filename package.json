{
    "name": "misub",
    "version": "2.7.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:server": "npx wrangler pages dev public --port 8787",
        "build": "vite build",
        "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.functions.json",
        "preview": "vite preview",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest --passWithNoTests",
        "test:run": "vitest run --passWithNoTests",
        "test:coverage": "vitest run --coverage --passWithNoTests",
        "smoke": "tsx scripts/smoke-subscription.mjs",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"functions/**/*.{js,ts}\" \"src/**/*.{js,ts,vue}\" \"tests/**/*.js\" \"scripts/**/*.{js,mjs,ts}\" \"vite.config.ts\" \"vitest.config.ts\" \"docs/**/*.md\"",
        "format:check": "prettier --check \"functions/**/*.{js,ts}\" \"src/**/*.{js,ts,vue}\" \"tests/**/*.js\" \"scripts/**/*.{js,mjs,ts}\" \"vite.config.ts\" \"vitest.config.ts\" \"docs/**/*.md\""
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "dompurify": "^3.2.6",
        "js-yaml": "^4.1.0",
        "pinia": "^3.0.3",
        "qrcode": "^1.5.4",
        "vue": "^3.5.18",
        "vue-router": "^4.6.4",
        "vuedraggable": "^4.1.0"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20260702.1",
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.1.18",
        "@types/js-yaml": "^4.0.9",
        "@types/qrcode": "^1.5.6",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vue/test-utils": "^2.4.6",
        "eslint": "^10.14.0",
        "eslint-plugin-vue": "^10.12.1",
        "globals": "^17.14.0",
        "happy-dom": "^20.0.11",
        "miniflare": "^4.20250803.0",
        "playwright": "^1.60.0",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.1.12",
        "terser": "^5.48.0",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.2",
        "vite": "^7.1.2",
        "vitest": "^4.0.16",
        "vue-tsc": "^3.3.14",
        "wrangler": "^4.56.0"
    }
}
